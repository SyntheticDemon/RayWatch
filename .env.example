# Ray cluster (collector / adapter)
RAY_VERSION=2.59.0
# Base URL of the Ray dashboard HTTP API (no trailing slash). Remote example:
# RAY_DASHBOARD_URL=http://10.0.0.12:8265
# With SSH tunnel to head: ssh -N -L 8265:127.0.0.1:8265 user@head && RAY_DASHBOARD_URL=http://127.0.0.1:8265
RAY_DASHBOARD_URL=http://127.0.0.1:8265
# Used by Ray client tooling; RayWatch ingest uses RAY_DASHBOARD_URL HTTP only today.
RAY_ADDRESS=ray://127.0.0.1:10001
# Live Ray in API (unset RAYWATCH_FIXTURE_JOBS)
RAYWATCH_USE_LIVE=1

# Postgres (history + job snapshots)
DATABASE_URL=postgresql://raywatch:raywatch@postgres:5432/raywatch

# API
API_HOST=0.0.0.0
API_PORT=8080

# Frontend (build-time)
VITE_API_BASE_URL=http://localhost:8080
